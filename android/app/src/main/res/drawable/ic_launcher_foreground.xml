<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher foreground: the Poop mark — a flat three-tier swirl silhouette in the app's
     emphasised light grey. Master copy lives at docs/logo.svg; keep the two in step.

     All geometry sits within roughly x/y 20..88 of the 108 viewport: the launcher masks this canvas
     down to as little as a 66dp circle, so anything wider gets clipped on some devices. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
    <!-- Base tier: widest, flat-bottomed with softened corners. -->
    <path
        android:pathData="M27,87 A5,5 0 0 1 22,82 C22,68.5 35,60.5 54,60.5 C73,60.5 86,68.5 86,82 A5,5 0 0 1 81,87 Z"
        android:fillColor="#E6E6EA"/>
    <!-- Middle tier: overlaps the base so the union reads as one continuous form. -->
    <path
        android:pathData="M31.5,62 C31.5,49.5 41,42.5 54,42.5 C67,42.5 76.5,49.5 76.5,62 Z"
        android:fillColor="#E6E6EA"/>
    <!-- Top tier: tapers to a soft point — the curl, without drawing a curl. -->
    <path
        android:pathData="M40.5,44 C40.5,31 46,21 54,21 C62,21 67.5,31 67.5,44 Z"
        android:fillColor="#E6E6EA"/>
</vector>
