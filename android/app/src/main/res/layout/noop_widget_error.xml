<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback the widget shows if Glance composition ever fails (NoopGlanceWidget.onCompositionError)
     instead of crashing the app process. Uses the shared colour resources so it matches the Glance
     widget's own surface (WidgetPalette) rather than carrying a third hardcoded palette. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="12dp"
    android:background="@color/surface_raised"
    android:textColor="@color/text_secondary"
    android:textSize="12sp"
    android:text="@string/widget_error" />
